public interface AuditLogRepository extends CrudRepository<AuditLog, Long> {

    long countByUsernameAndActionAndCreatedAtAfter(
            String username, List<AuditActions> action, Instant createdAt
    );

}


public interface AuditLogService {
    void logAudit(String username, AuditActions action);

    void checkRateLimit(String username, int seconds, List<AuditActions> targetActions);
}


@Service
@RequiredArgsConstructor
public class AuditLogServiceImpl implements AuditLogService {

    private final AuditLogRepository auditLogRepository;

    @Override
    public void logAudit(String username, AuditActions action) {
        AuditLog log = new AuditLog();
        log.setUsername(username);
        log.setAction(action);

        auditLogRepository.save(log);
    }

    @Override
    public void checkRateLimit(String username, int seconds, List<AuditActions> targetActions) {
        Instant timeAgo = Instant.now().minusSeconds(seconds);

        long failedAttempts = auditLogRepository.countByUsernameAndActionAndCreatedAtAfter(
                username,
                targetActions,
                timeAgo
        );

        if (failedAttempts >= NUMBER_OF_FAILINGS_UNTIL_RATE_LIMIT) {
            throw new ResponseStatusException(
                    HttpStatus.TOO_MANY_REQUESTS,
                    "Zu viele fehlerhafte Versuche. Bitte warte ein paar Minuten."
            );
        }
    }
}

@Getter
@Setter
@Builder
@NoArgsConstructor
@AllArgsConstructor
@Table(name = "TOTP_AUDIT_LOG")
public class AuditLog {

    @Id
    @Column("ID")
    private Long id;


    @Column("USERNAME")
    private String username;

    @CreatedBy
    @Column("ACTING_USER")
    private String actingUser;

    @Column("ACTION")
    private AuditActions action;

    @CreatedDate
    @InsertOnlyProperty
    @Column("CREATED_AT")
    private Instant createdAt;

}

             
             
