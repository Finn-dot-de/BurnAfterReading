    @Test
    void validateCodeGeneratesAndHashesRecoveryKeyOnFirstActivation() throws GeneralSecurityException {
        // 1. Arrange
        TotpCredentials creds = new TotpCredentials();
        creds.setAlgorithm(Algorithm.SHA1);
        creds.setSecretKey("enc-secret");
        creds.setActivatedAt(null);

        when(repository.findByUsernameIgnoreCase("user")).thenReturn(Optional.of(creds));
        when(otpServiceProperties.getDefaultPasswordHashFormat()).thenReturn(PasswordHashFormat.SHA512_DOT_SALT);

        when(codeVerifiers.get("SHA1")).thenReturn(codeVerifier);
        when(encryptionService.decrypt("enc-secret")).thenReturn("decrypted");
        when(codeVerifier.isValidCode("decrypted", "123456")).thenReturn(true);

        // 2. Act
        var result = totpService.validateCode("user", "123456");

        // 3. Assert
        assertThat(result).isPresent();
        String rawGeneratedKey = result.get().recoveryKey();
        assertThat(rawGeneratedKey).isNotNull();

        verify(repository).save(totpCredentialsCaptor.capture());
        TotpCredentials saved = totpCredentialsCaptor.getValue();

        assertThat(saved.getRecoveryKeyFormat()).isEqualTo(PasswordHashFormat.SHA512_DOT_SALT);
        assertThat(saved.getActivatedAt()).isNotNull();
        assertThat(PasswordHashFormat.SHA512_DOT_SALT.check(rawGeneratedKey.strip().replaceAll("\\s+", ""), saved.getRecoveryKey())).isTrue();
        assertThat(result.get().recoveryKey()).isNotNull();
        verify(rateLimitService).logAudit("user", AuditActions.VALIDATE_SUCCESS);
    }

