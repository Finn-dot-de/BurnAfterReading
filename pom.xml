
        // 3. Assert
        verify(encryptionService).encrypt(rawSecret);
        verify(repository).save(totpCredentialsCaptor.capture());
        verify(rateLimitService).logAudit("testuser", AuditActions.SETUP_SUCCESS);
        assertEquals(encryptedSecret, totpCredentialsCaptor.getValue().getSecretKey());
    }
