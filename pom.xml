import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpStatus;
import org.springframework.web.server.ResponseStatusException;

import java.time.Instant;
import java.util.List;

import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyList;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class RateLimitServiceImplTest {

    @Mock
    private AuditLogRepository auditLogRepository;

    @InjectMocks
    private RateLimitServiceImpl rateLimitService;

    @Test
    void checkRateLimitThrowsExceptionWhenLimitExceeded() {
        // Arrange
        String username = "testuser";
        int seconds = 30;
        List<AuditActions> actions = List.of(AuditActions.VALIDATE_FAILURE, AuditActions.RESET_FAILURE, AuditActions.SETUP_FAILURE);

        when(auditLogRepository.countByUsernameAndActionInAndCreatedAtAfter(
                eq(username), anyList(), any(Instant.class)))
                .thenReturn((long) OtpServiceProperties.NUMBER_OF_FAILINGS_UNTIL_RATE_LIMIT);

        // Act & Assert
        assertThatThrownBy(() -> rateLimitService.checkRateLimit(username, seconds, actions))
                .isInstanceOf(ResponseStatusException.class)
                .hasFieldOrPropertyWithValue("status", HttpStatus.TOO_MANY_REQUESTS)
                .hasMessageContaining("Zu viele fehlerhafte Versuche");
    }

    @Test
    void checkRateLimitPassesWhenUnderLimit() {
        // Arrange
        String username = "testuser";
        int seconds = 30;
        // Kleine semantische Anpassung: Meistens checkt man beim Limit ja die Fehler (FAILURE) und nicht die Erfolge (SUCCESS) ;)
        List<AuditActions> actions = List.of(AuditActions.VALIDATE_FAILURE); 

        when(auditLogRepository.countByUsernameAndActionInAndCreatedAtAfter(
                eq(username), anyList(), any(Instant.class)))
                .thenReturn((long) OtpServiceProperties.NUMBER_OF_FAILINGS_UNTIL_RATE_LIMIT - 1L);

        // Act & Assert
        assertDoesNotThrow(() -> rateLimitService.checkRateLimit(username, seconds, actions));
    }
}
