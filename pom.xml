@ExtendWith(MockitoExtension.class)
public class RateLimitServiceImplTest {

    @Mock
    private AuditLogRepository auditLogRepository;

    @InjectMocks
    private RateLimitServiceImpl auditLogService;

    @Captor
    private ArgumentCaptor<AuditLog> auditLogCaptor;

    @Test
    void logAuditSavesCorrectEntityToDatabase() {
        // Arrange
        String username = "testuser";

        // Act
        auditLogService.logAudit(username, AuditActions.VALIDATE_SUCCESS);

        // Assert
        verify(auditLogRepository).save(auditLogCaptor.capture());
        AuditLog savedLog = auditLogCaptor.getValue();

        assertThat(savedLog.getUsername()).isEqualTo(username);
        assertThat(savedLog.getAction()).isEqualTo(AuditActions.VALIDATE_SUCCESS);
    }

    @Test
    void checkRateLimitThrowsExceptionWhenLimitExceeded() {
        // Arrange
        String username = "testuser";
        int seconds = 30;
        List<AuditActions> actions = List.of(AuditActions.VALIDATE_FAILURE, AuditActions.RESET_FAILURE, AuditActions.SETUP_FAILURE);

        when(auditLogRepository.countByUsernameAndActionInAndCreatedAtAfter(
                eq(username), anyList(), any(Instant.class)))
                .thenReturn((long) OtpServiceProperties.NUMBER_OF_FAILINGS_UNTIL_RATE_LIMIT);

        // Act & Assert
        assertThatThrownBy(() -> auditLogService.checkRateLimit(username, seconds, actions))
                .isInstanceOf(ResponseStatusException.class)
                .hasFieldOrPropertyWithValue("status", HttpStatus.TOO_MANY_REQUESTS)
                .hasMessageContaining("Zu viele fehlerhafte Versuche");
    }

    @Test
    void checkRateLimitPassesWhenUnderLimit() {
        // Arrange
        String username = "testuser";
        int seconds = 30;
        List<AuditActions> actions = List.of(AuditActions.VALIDATE_SUCCESS);

        when(auditLogRepository.countByUsernameAndActionInAndCreatedAtAfter(
                eq(username), anyList(), any(Instant.class)))
                .thenReturn((long) OtpServiceProperties.NUMBER_OF_FAILINGS_UNTIL_RATE_LIMIT - 1L);

        // Act & Assert
        assertDoesNotThrow(() -> auditLogService.checkRateLimit(username, seconds, actions));
    }
}
